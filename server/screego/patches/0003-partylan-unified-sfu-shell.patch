diff --git a/ui/src/partylanMode.ts b/ui/src/partylanMode.ts
new file mode 100644
index 0000000..b163911
--- /dev/null
+++ b/ui/src/partylanMode.ts
@@ -0,0 +1,17 @@
+export type PartyLANModeHost = {
+    __PARTYLAN_SFU_ONLY__?: unknown;
+};
+
+const currentHost = (): PartyLANModeHost | undefined =>
+    typeof window === 'undefined' ? undefined : (window as unknown as PartyLANModeHost);
+
+export const isPartyLANSFUOnly = (host: PartyLANModeHost | undefined = currentHost()): boolean =>
+    host?.__PARTYLAN_SFU_ONLY__ === true;
+
+export const shouldHandleScreegoPeerSession = (
+    host: PartyLANModeHost | undefined = currentHost()
+): boolean => !isPartyLANSFUOnly(host);
+
+export const shouldSignalScreegoShare = (
+    host: PartyLANModeHost | undefined = currentHost()
+): boolean => !isPartyLANSFUOnly(host);
diff --git a/ui/src/partylanMode.test.mjs b/ui/src/partylanMode.test.mjs
new file mode 100644
index 0000000..db14e8b
--- /dev/null
+++ b/ui/src/partylanMode.test.mjs
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import test from 'node:test';
+
+import {
+    isPartyLANSFUOnly,
+    shouldHandleScreegoPeerSession,
+    shouldSignalScreegoShare,
+} from './partylanMode.ts';
+
+test('PartyLAN SFU-only mode requires an explicit true flag', () => {
+    assert.equal(isPartyLANSFUOnly({__PARTYLAN_SFU_ONLY__: true}), true);
+    assert.equal(isPartyLANSFUOnly({__PARTYLAN_SFU_ONLY__: false}), false);
+    assert.equal(isPartyLANSFUOnly({}), false);
+    assert.equal(isPartyLANSFUOnly(undefined), false);
+});
+
+test('SFU-only rooms suppress Screego peer sessions and share signaling', () => {
+    const unified = {__PARTYLAN_SFU_ONLY__: true};
+    const legacy = {__PARTYLAN_SFU_ONLY__: false};
+    assert.equal(shouldHandleScreegoPeerSession(unified), false);
+    assert.equal(shouldSignalScreegoShare(unified), false);
+    assert.equal(shouldHandleScreegoPeerSession(legacy), true);
+    assert.equal(shouldSignalScreegoShare(legacy), true);
+});
+
+test('Room member tooltip exposes a stable PartyLAN roster anchor and rollback list', async () => {
+    const roomSource = await readFile(new URL('./Room.tsx', import.meta.url), 'utf8');
+    assert.match(roomSource, /id="partylan-presence-roster"/);
+    assert.match(roomSource, /data-partylan-legacy-roster/);
+});
