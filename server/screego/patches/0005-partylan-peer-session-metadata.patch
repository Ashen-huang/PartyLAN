+type PartyLANPeerSessionWindow = Window & {
+    __PARTYLAN_REGISTER_PEER_SESSION__?: (metadata: {
+        action: 'open' | 'close';
+        pc: RTCPeerConnection;
+        sid: string;
+        peerId: string;
+        role: PeerRole;
+    }) => void;
+};
+
+const notifyPartyLANPeerSession = (
+    session: PeerSession,
+    action: 'open' | 'close'
+): void => {
+    try {
+        if (typeof window === 'undefined') return;
+        const hook = (window as PartyLANPeerSessionWindow).__PARTYLAN_REGISTER_PEER_SESSION__;
+        if (typeof hook !== 'function') return;
+        hook({
+            action,
+            pc: session.pc,
+            sid: session.sid,
+            peerId: session.peerId,
+            role: session.role,
+        });
+    } catch (error) {
+        session.report({
+            type: 'partylan_peer_session_hook_failed',
+            sid: session.sid,
+            role: session.role,
+            generation: session.generation,
+            error: errorName(error),
+        });
+    }
+};
