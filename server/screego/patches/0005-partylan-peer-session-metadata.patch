+test('peer session metadata hook is exact, non-fatal and closes with the session', () => {
+    const metadata = [];
+    globalThis.window = {
+        __PARTYLAN_REGISTER_PEER_SESSION__: (event) => metadata.push(event),
+    };
+    const {pc, session} = makeSession();
+    assert.deepEqual(metadata.map(({action, sid, peerId, role}) => ({action, sid, peerId, role})), [
+        {action: 'open', sid: 'sid-1', peerId: 'peer-1', role: 'client'},
+    ]);
+    assert.equal(metadata[0].pc, pc);
+
+    closePeerSession(session);
+    assert.equal(metadata.at(-1).action, 'close');
+    assert.equal(metadata.at(-1).pc, pc);
+
+    globalThis.window.__PARTYLAN_REGISTER_PEER_SESSION__ = () => {
+        throw new Error('injected hook failed');
+    };
+    assert.doesNotThrow(() => makeSession());
+    delete globalThis.window;
+});
+
