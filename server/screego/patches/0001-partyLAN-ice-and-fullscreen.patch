diff --git a/ui/src/iceSession.test.mjs b/ui/src/iceSession.test.mjs
new file mode 100644
index 0000000..1d2a793
--- /dev/null
+++ b/ui/src/iceSession.test.mjs
@@ -0,0 +1,121 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import {
+    closePeerSession,
+    createPeerSession,
+    createPeerSessionRegistry,
+    flushRemoteCandidates,
+    queueRemoteCandidate,
+    setRemoteDescriptionForSession,
+} from './iceSession.ts';
+
+class FakePeerConnection {
+    added = [];
+    descriptions = [];
+    closed = false;
+    addFailures = [];
+
+    async addIceCandidate(candidate) {
+        const failure = this.addFailures.shift();
+        if (failure) throw failure;
+        this.added.push(candidate);
+    }
+
+    async setRemoteDescription(description) {
+        this.descriptions.push(description);
+    }
+
+    close() {
+        this.closed = true;
+    }
+}
+
+const makeSession = (report = () => undefined) => {
+    const pc = new FakePeerConnection();
+    return {
+        pc,
+        session: createPeerSession({sid: 'sid-1', peerId: 'peer-1', role: 'client', pc, report}),
+    };
+};
+
+test('candidates wait for the remote description and preserve order', async () => {
+    const {pc, session} = makeSession();
+    const first = {candidate: 'candidate:first', usernameFragment: 'remote-a'};
+    const second = {candidate: 'candidate:second', usernameFragment: 'remote-a'};
+
+    await queueRemoteCandidate(session, first);
+    await queueRemoteCandidate(session, second);
+    assert.deepEqual(pc.added, []);
+
+    await setRemoteDescriptionForSession(session, {
+        type: 'offer',
+        sdp: 'v=0\r\na=ice-ufrag:remote-a\r\n',
+    });
+    assert.deepEqual(pc.added, [first, second]);
+});
+
+test('operations arriving before session registration are replayed in order', async () => {
+    const registry = createPeerSessionRegistry();
+    const calls = [];
+    const first = registry.run('sid-1', async () => calls.push('candidate'));
+    const second = registry.run('sid-1', async () => calls.push('description'));
+    const {session} = makeSession();
+
+    registry.register(session);
+    await Promise.all([first, second]);
+    assert.deepEqual(calls, ['candidate', 'description']);
+});
+
+test('retryable InvalidStateError keeps the candidate for a later flush', async () => {
+    const events = [];
+    const {pc, session} = makeSession((event) => events.push(event));
+    await setRemoteDescriptionForSession(session, {
+        type: 'offer',
+        sdp: 'v=0\r\na=ice-ufrag:remote-a\r\n',
+    });
+    const retry = new Error('remote description not ready');
+    retry.name = 'InvalidStateError';
+    pc.addFailures.push(retry);
+
+    const candidate = {candidate: 'candidate:retry', usernameFragment: 'remote-a'};
+    await queueRemoteCandidate(session, candidate);
+    assert.equal(session.pendingRemoteCandidates.length, 1);
+    assert.equal(events.at(-1).type, 'ice_candidate_retry');
+
+    await flushRemoteCandidates(session);
+    assert.deepEqual(pc.added, [candidate]);
+    assert.equal(session.pendingRemoteCandidates.length, 0);
+});
+
+test('a new remote username fragment advances generation and drops stale candidates', async () => {
+    const events = [];
+    const {pc, session} = makeSession((event) => events.push(event));
+    await setRemoteDescriptionForSession(session, {
+        type: 'offer',
+        sdp: 'v=0\r\na=ice-ufrag:remote-a\r\n',
+    });
+    await setRemoteDescriptionForSession(session, {
+        type: 'offer',
+        sdp: 'v=0\r\na=ice-ufrag:remote-b\r\n',
+    });
+    await queueRemoteCandidate(session, {
+        candidate: 'candidate:old',
+        usernameFragment: 'remote-a',
+    });
+
+    assert.equal(session.generation, 1);
+    assert.deepEqual(pc.added, []);
+    assert.equal(events.at(-1).type, 'ice_candidate_stale');
+});
+
+test('closing a session clears queued candidates and ignores late candidates', async () => {
+    const {pc, session} = makeSession();
+    await queueRemoteCandidate(session, {candidate: 'candidate:queued'});
+    closePeerSession(session);
+    await queueRemoteCandidate(session, {candidate: 'candidate:late'});
+
+    assert.equal(pc.closed, true);
+    assert.equal(session.pendingRemoteCandidates.length, 0);
+    assert.deepEqual(pc.added, []);
+});
diff --git a/ui/src/iceSession.ts b/ui/src/iceSession.ts
new file mode 100644
index 0000000..8d3d2f7
--- /dev/null
+++ b/ui/src/iceSession.ts
@@ -0,0 +1,223 @@
+export type PeerRole = 'host' | 'client';
+
+export type IceDiagnostic = {
+    type: string;
+    sid: string;
+    role: PeerRole;
+    generation: number;
+    error?: string;
+};
+
+export type PeerSession = {
+    sid: string;
+    peerId: string;
+    role: PeerRole;
+    pc: RTCPeerConnection;
+    remoteDescriptionReady: boolean;
+    pendingRemoteCandidates: RTCIceCandidateInit[];
+    remoteUsernameFragment?: string;
+    generation: number;
+    closed: boolean;
+    recoveryCount: number;
+    cooldownUntil: number;
+    report: (event: IceDiagnostic) => void;
+};
+
+type SessionOperation = (session: PeerSession) => Promise<void> | void;
+
+export type PeerSessionRegistry = {
+    register: (session: PeerSession) => void;
+    run: (sid: string, operation: SessionOperation) => Promise<void>;
+    get: (sid: string) => PeerSession | undefined;
+    close: (sid: string) => void;
+    closeAll: () => void;
+};
+
+const usernameFragmentFromSDP = (sdp?: string): string | undefined => {
+    const match = sdp?.match(/^a=ice-ufrag:([^\r\n]+)/m);
+    return match?.[1];
+};
+
+const errorName = (error: unknown): string =>
+    error instanceof Error ? `${error.name}: ${error.message}` : String(error);
+
+const isRetryableCandidateError = (error: unknown): boolean =>
+    error instanceof DOMException
+        ? error.name === 'InvalidStateError'
+        : error instanceof Error && error.name === 'InvalidStateError';
+
+export const createPeerSession = ({
+    sid,
+    peerId,
+    role,
+    pc,
+    report = () => undefined,
+}: {
+    sid: string;
+    peerId: string;
+    role: PeerRole;
+    pc: RTCPeerConnection;
+    report?: (event: IceDiagnostic) => void;
+}): PeerSession => ({
+    sid,
+    peerId,
+    role,
+    pc,
+    remoteDescriptionReady: false,
+    pendingRemoteCandidates: [],
+    generation: 0,
+    closed: false,
+    recoveryCount: 0,
+    cooldownUntil: 0,
+    report,
+});
+
+export const createPeerSessionRegistry = (): PeerSessionRegistry => {
+    const sessions = new Map<string, PeerSession>();
+    const pending = new Map<
+        string,
+        Array<{
+            operation: SessionOperation;
+            resolve: () => void;
+            reject: (error: unknown) => void;
+        }>
+    >();
+
+    const runOperation = async (session: PeerSession, operation: SessionOperation) => {
+        if (!session.closed) await operation(session);
+    };
+
+    return {
+        register(session) {
+            sessions.set(session.sid, session);
+            const queued = pending.get(session.sid) || [];
+            pending.delete(session.sid);
+            void queued.reduce(
+                (chain, item) =>
+                    chain
+                        .then(() => runOperation(session, item.operation))
+                        .then(item.resolve, item.reject),
+                Promise.resolve()
+            );
+        },
+        run(sid, operation) {
+            const session = sessions.get(sid);
+            if (session) return runOperation(session, operation);
+            return new Promise<void>((resolve, reject) => {
+                const queued = pending.get(sid) || [];
+                queued.push({operation, resolve, reject});
+                pending.set(sid, queued);
+            });
+        },
+        get(sid) {
+            return sessions.get(sid);
+        },
+        close(sid) {
+            const session = sessions.get(sid);
+            if (session) closePeerSession(session);
+            sessions.delete(sid);
+            const queued = pending.get(sid) || [];
+            queued.forEach((item) => item.resolve());
+            pending.delete(sid);
+        },
+        closeAll() {
+            sessions.forEach(closePeerSession);
+            sessions.clear();
+            pending.forEach((queued) => queued.forEach((item) => item.resolve()));
+            pending.clear();
+        },
+    };
+};
+
+const candidateMatchesGeneration = (
+    session: PeerSession,
+    candidate: RTCIceCandidateInit
+): boolean =>
+    !candidate.usernameFragment ||
+    !session.remoteUsernameFragment ||
+    candidate.usernameFragment === session.remoteUsernameFragment;
+
+export const flushRemoteCandidates = async (session: PeerSession): Promise<void> => {
+    if (session.closed || !session.remoteDescriptionReady) return;
+
+    while (session.pendingRemoteCandidates.length > 0) {
+        const candidate = session.pendingRemoteCandidates[0];
+        if (!candidateMatchesGeneration(session, candidate)) {
+            session.pendingRemoteCandidates.shift();
+            session.report({
+                type: 'ice_candidate_stale',
+                sid: session.sid,
+                role: session.role,
+                generation: session.generation,
+            });
+            continue;
+        }
+
+        try {
+            await session.pc.addIceCandidate(candidate);
+            session.pendingRemoteCandidates.shift();
+        } catch (error) {
+            session.report({
+                type: isRetryableCandidateError(error)
+                    ? 'ice_candidate_retry'
+                    : 'ice_candidate_failed',
+                sid: session.sid,
+                role: session.role,
+                generation: session.generation,
+                error: errorName(error),
+            });
+            if (!isRetryableCandidateError(error)) {
+                session.pendingRemoteCandidates.shift();
+                continue;
+            }
+            return;
+        }
+    }
+};
+
+export const queueRemoteCandidate = (
+    session: PeerSession,
+    candidate: RTCIceCandidateInit
+): Promise<void> => {
+    if (session.closed) return Promise.resolve();
+    session.pendingRemoteCandidates.push(candidate);
+    return flushRemoteCandidates(session);
+};
+
+export const setRemoteDescriptionForSession = async (
+    session: PeerSession,
+    description: RTCSessionDescriptionInit
+): Promise<void> => {
+    if (session.closed) return;
+
+    try {
+        await session.pc.setRemoteDescription(description);
+        const nextUsernameFragment = usernameFragmentFromSDP(description.sdp);
+        if (
+            session.remoteUsernameFragment &&
+            nextUsernameFragment &&
+            session.remoteUsernameFragment !== nextUsernameFragment
+        ) {
+            session.generation += 1;
+        }
+        session.remoteUsernameFragment = nextUsernameFragment;
+        session.remoteDescriptionReady = true;
+        await flushRemoteCandidates(session);
+    } catch (error) {
+        session.report({
+            type: 'remote_description_failed',
+            sid: session.sid,
+            role: session.role,
+            generation: session.generation,
+            error: errorName(error),
+        });
+        throw error;
+    }
+};
+
+export const closePeerSession = (session: PeerSession): void => {
+    if (session.closed) return;
+    session.closed = true;
+    session.pendingRemoteCandidates.length = 0;
+    session.pc.close();
+};
