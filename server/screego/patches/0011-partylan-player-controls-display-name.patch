+func TestAuthenticatedUsersCanChooseDisplayNames(t *testing.T) {
+	rooms := &Rooms{
+		Rooms:     map[string]*Room{},
+		connected: map[xid.ID]string{},
+		config: config.Config{
+			AuthMode:       config.AuthModeAll,
+			TurnIPProvider: &ipdns.Static{V4: net.ParseIP("127.0.0.1")},
+		},
+	}
+	creator := lifecycleClient("alice-account")
+	member := lifecycleClient("bob-account")
+
+	if err := (&Create{
+		ID: "alice-account", Mode: ConnectionTURN, UserName: "  Alice Display  ",
+	}).Execute(rooms, creator); err != nil {
+		t.Fatalf("create room: %v", err)
+	}
+	if got := rooms.Rooms["alice-account"].Users[creator.ID].Name; got != "Alice Display" {
+		t.Fatalf("creator display name = %q, want %q", got, "Alice Display")
+	}
+
+	if err := (&Join{ID: "alice-account", UserName: "Bob Display"}).Execute(rooms, member); err != nil {
+		t.Fatalf("join room: %v", err)
+	}
+	if got := rooms.Rooms["alice-account"].Users[member.ID].Name; got != "Bob Display" {
+		t.Fatalf("member display name = %q, want %q", got, "Bob Display")
+	}
+}
+
+func TestAuthenticatedDisplayNameFallsBackToAccount(t *testing.T) {
+	rooms := &Rooms{
+		Rooms:     map[string]*Room{},
+		connected: map[xid.ID]string{},
+		config:    config.Config{AuthMode: config.AuthModeAll},
+	}
+	creator := lifecycleClient("alice-account")
+
+	if err := (&Create{
+		ID: "alice-account", Mode: ConnectionTURN, UserName: "   ",
+	}).Execute(rooms, creator); err != nil {
+		t.Fatalf("create room: %v", err)
+	}
+	if got := rooms.Rooms["alice-account"].Users[creator.ID].Name; got != "alice-account" {
+		t.Fatalf("creator fallback name = %q, want %q", got, "alice-account")
+	}
+}
