--- /dev/null
+++ b/ws/event_ice_restart_request.go
@@ -0,0 +1,42 @@
+package ws
+
+import (
+	"fmt"
+
+	"github.com/rs/zerolog/log"
+	"github.com/screego/server/ws/outgoing"
+)
+
+func init() {
+	register("icerestartrequest", func() Event {
+		return &IceRestartRequest{}
+	})
+}
+
+type IceRestartRequest outgoing.IceRecoveryRequest
+
+func (e *IceRestartRequest) Execute(rooms *Rooms, current ClientInfo) error {
+	room, err := rooms.CurrentRoom(current)
+	if err != nil {
+		return err
+	}
+
+	session, ok := room.Sessions[e.SID]
+	if !ok {
+		log.Debug().Str("id", e.SID.String()).Msg("unknown session")
+		return nil
+	}
+	if session.Client != current.ID {
+		return fmt.Errorf("permission denied for session %s", e.SID)
+	}
+	if e.Action != "restart" && e.Action != "protect" && e.Action != "recover" {
+		return fmt.Errorf("invalid ICE recovery action %q", e.Action)
+	}
+
+	host, ok := room.Users[session.Host]
+	if !ok {
+		return fmt.Errorf("host unavailable for session %s", e.SID)
+	}
+	host.WriteTimeout(outgoing.IceRecoveryRequest(*e))
+	return nil
+}
