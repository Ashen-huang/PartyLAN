@@ -0,0 +1,52 @@
+package ws
+
+import (
+	"testing"
+
+	"github.com/rs/xid"
+	"github.com/screego/server/ws/outgoing"
+)
+
+func TestIceRestartRequestOnlyClientCanForwardToSessionHost(t *testing.T) {
+	roomID := "room-1"
+	hostID := xid.New()
+	clientID := xid.New()
+	sessionID := xid.New()
+	hostWrites := make(chan outgoing.Message, 1)
+	clientWrites := make(chan outgoing.Message, 1)
+	room := &Room{
+		ID: roomID,
+		Users: map[xid.ID]*User{
+			hostID:   {ID: hostID, _write: hostWrites},
+			clientID: {ID: clientID, _write: clientWrites},
+		},
+		Sessions: map[xid.ID]*RoomSession{
+			sessionID: {Host: hostID, Client: clientID},
+		},
+	}
+	rooms := &Rooms{
+		Rooms: map[string]*Room{roomID: room},
+		connected: map[xid.ID]string{
+			hostID:   roomID,
+			clientID: roomID,
+		},
+	}
+
+	request := &IceRestartRequest{SID: sessionID, Action: "restart"}
+	if err := request.Execute(rooms, ClientInfo{ID: clientID}); err != nil {
+		t.Fatalf("client recovery request: %v", err)
+	}
+	select {
+	case message := <-hostWrites:
+		forwarded, ok := message.(outgoing.IceRecoveryRequest)
+		if !ok || forwarded.SID != sessionID || forwarded.Action != "restart" {
+			t.Fatalf("forwarded message = %#v", message)
+		}
+	default:
+		t.Fatal("host did not receive recovery request")
+	}
+
+	if err := request.Execute(rooms, ClientInfo{ID: hostID}); err == nil {
+		t.Fatal("host must not impersonate the session client")
+	}
+}
