+const settleIceRestart = (
+    session: PeerSession,
+    completed: boolean,
+    eventType: string
+): void => {
+    if (!session.restartPromise) return;
+    if (session.restartTimer) clearTimeout(session.restartTimer);
+    session.restartTimer = undefined;
+    const resolve = session.restartResolve;
+    session.restartPromise = undefined;
+    session.restartResolve = undefined;
+    session.report({
+        type: eventType,
+        sid: session.sid,
+        role: session.role,
+        generation: session.generation,
+    });
+    resolve?.(completed);
+};
+
+export const requestHostIceRestart = (
+    session: PeerSession,
+    sendOffer: (offer: RTCSessionDescriptionInit) => void | Promise<void>,
+    {timeoutMs = 10000}: {timeoutMs?: number} = {}
+): Promise<boolean> => {
+    if (session.restartPromise) return session.restartPromise;
+    if (session.closed || session.role !== 'host' || session.recoveryCount >= 1) {
+        session.report({
+            type: 'ice_restart_rejected',
+            sid: session.sid,
+            role: session.role,
+            generation: session.generation,
+        });
+        return Promise.resolve(false);
+    }
+
+    session.recoveryCount += 1;
+    session.remoteDescriptionReady = false;
+    session.pendingRemoteCandidates.length = 0;
+    session.restartPromise = new Promise<boolean>((resolve) => {
+        session.restartResolve = resolve;
+    });
+    session.restartTimer = setTimeout(
+        () => settleIceRestart(session, false, 'ice_restart_timeout'),
+        Math.max(1, timeoutMs)
+    );
+    session.report({
+        type: 'ice_restart_started',
+        sid: session.sid,
+        role: session.role,
+        generation: session.generation,
+    });
+
+    void (async () => {
+        const offer = await session.pc.createOffer({
+            offerToReceiveVideo: true,
+            iceRestart: true,
+        });
+        await session.pc.setLocalDescription(offer);
+        await sendOffer(offer);
+    })().catch((error) => {
+        session.report({
+            type: 'ice_restart_failed',
+            sid: session.sid,
+            role: session.role,
+            generation: session.generation,
+            error: errorName(error),
+        });
+        settleIceRestart(session, false, 'ice_restart_finished');
+    });
+
+    return session.restartPromise;
+};
+
 export const closePeerSession = (session: PeerSession): void => {
     if (session.closed) return;
+    settleIceRestart(session, false, 'ice_restart_cancelled');
     session.closed = true;
     session.pendingRemoteCandidates.length = 0;
     session.pc.close();
