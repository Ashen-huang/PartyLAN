+		Path:     "/",
+		MaxAge:   maxAge,
+		HttpOnly: true,
+		Secure:   r.TLS != nil || strings.EqualFold(forwardedProto, "https"),
+		SameSite: http.SameSiteLaxMode,
+	}
+}
