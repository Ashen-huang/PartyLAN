@@ -0,0 +1,67 @@
+package ws
+
+import (
+	"net"
+	"testing"
+
+	"github.com/gorilla/websocket"
+	"github.com/rs/xid"
+	"github.com/screego/server/config"
+	"github.com/screego/server/ws/outgoing"
+)
+
+func lifecycleClient(name string) ClientInfo {
+	return ClientInfo{
+		ID:                xid.New(),
+		Authenticated:     true,
+		AuthenticatedUser: name,
+		Write:             make(chan outgoing.Message, 8),
+		Addr:              net.ParseIP("127.0.0.1"),
+	}
+}
+
+func TestRoomStaysOpenUntilLastMemberLeaves(t *testing.T) {
+	rooms := &Rooms{
+		Rooms:     map[string]*Room{},
+		connected: map[xid.ID]string{},
+		config:    config.Config{AuthMode: config.AuthModeAll},
+	}
+	creator := lifecycleClient("alice")
+	member := lifecycleClient("bob")
+
+	if err := (&Create{
+		ID:                "alice",
+		Mode:              ConnectionTURN,
+		CloseOnOwnerLeave: true,
+	}).Execute(rooms, creator); err != nil {
+		t.Fatalf("create room: %v", err)
+	}
+
+	created := <-creator.Write
+	roomMessage, ok := created.(outgoing.Room)
+	if !ok || len(roomMessage.Users) != 1 {
+		t.Fatalf("unexpected room message: %#v", created)
+	}
+	if roomMessage.Users[0].Owner {
+		t.Fatal("room protocol must not expose an owner")
+	}
+
+	room := rooms.Rooms["alice"]
+	room.Users[member.ID] = &User{
+		ID: member.ID, Addr: member.Addr, Name: member.AuthenticatedUser, _write: member.Write,
+	}
+	rooms.connected[member.ID] = room.ID
+
+	(&Disconnected{Code: websocket.CloseNormalClosure, Reason: "creator left"}).executeNoError(rooms, creator)
+	if _, ok := rooms.Rooms[room.ID]; !ok {
+		t.Fatal("room closed while another member was still connected")
+	}
+	if _, ok := room.Users[member.ID]; !ok {
+		t.Fatal("remaining member was removed with the creator")
+	}
+
+	(&Disconnected{Code: websocket.CloseNormalClosure, Reason: "last member left"}).executeNoError(rooms, member)
+	if _, ok := rooms.Rooms[room.ID]; ok {
+		t.Fatal("empty room must be closed")
+	}
+}
