diff --git a/auth/auth_session_test.go b/auth/auth_session_test.go
new file mode 100644
index 0000000..49861a3
--- /dev/null
+++ b/auth/auth_session_test.go
@@ -0,0 +1,87 @@
+package auth
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/gorilla/sessions"
+)
+
+func TestAuthenticateCreatesPersistentDeviceCookie(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "users.htpasswd")
+	writePasswordFile(t, path, passwordRecord(t, "device-user", "device-pass"))
+	users, err := ReadPasswordsFile(path, []byte("01234567890123456789012345678901"), 3600)
+	if err != nil {
+		t.Fatalf("read passwords file: %v", err)
+	}
+
+	form := url.Values{"user": {"device-user"}, "pass": {"device-pass"}}
+	request := httptest.NewRequest(http.MethodPost, "/login", strings.NewReader(form.Encode()))
+	request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	request.Header.Set("X-Forwarded-Proto", "https")
+	response := httptest.NewRecorder()
+	users.Authenticate(response, request)
+
+	if response.Code != http.StatusOK {
+		t.Fatalf("authenticate status = %d, want %d", response.Code, http.StatusOK)
+	}
+	cookies := response.Result().Cookies()
+	if len(cookies) != 1 {
+		t.Fatalf("cookie count = %d, want 1", len(cookies))
+	}
+	cookie := cookies[0]
+	if cookie.MaxAge != 3600 {
+		t.Fatalf("cookie MaxAge = %d, want 3600", cookie.MaxAge)
+	}
+	if !cookie.HttpOnly || !cookie.Secure || cookie.SameSite != http.SameSiteLaxMode {
+		t.Fatalf("cookie flags = HttpOnly:%t Secure:%t SameSite:%d", cookie.HttpOnly, cookie.Secure, cookie.SameSite)
+	}
+}
+
+func TestRefreshSessionUpgradesSessionOnlyCookie(t *testing.T) {
+	users, err := ReadPasswordsFile("", []byte("01234567890123456789012345678901"), 3600)
+	if err != nil {
+		t.Fatalf("create users: %v", err)
+	}
+
+	oldRequest := httptest.NewRequest(http.MethodGet, "/config", nil)
+	oldResponse := httptest.NewRecorder()
+	oldSession := sessions.NewSession(users.store, "user")
+	oldSession.Options = &sessions.Options{Path: "/"}
+	oldSession.Values["user"] = "device-user"
+	if err := users.store.Save(oldRequest, oldResponse, oldSession); err != nil {
+		t.Fatalf("save session-only cookie: %v", err)
+	}
+
+	request := httptest.NewRequest(http.MethodGet, "/config", nil)
+	request.Header.Set("X-Forwarded-Proto", "https")
+	request.AddCookie(oldResponse.Result().Cookies()[0])
+	response := httptest.NewRecorder()
+	if err := users.RefreshSession(response, request); err != nil {
+		t.Fatalf("refresh session: %v", err)
+	}
+
+	cookies := response.Result().Cookies()
+	if len(cookies) != 1 || cookies[0].MaxAge != 3600 || !cookies[0].Secure {
+		t.Fatalf("refreshed cookie is not persistent: %#v", cookies)
+	}
+}
+
+func TestLogoutExpiresPersistentDeviceCookie(t *testing.T) {
+	users, err := ReadPasswordsFile("", []byte("01234567890123456789012345678901"), 3600)
+	if err != nil {
+		t.Fatalf("create users: %v", err)
+	}
+	request := httptest.NewRequest(http.MethodPost, "/logout", nil)
+	response := httptest.NewRecorder()
+	users.Logout(response, request)
+
+	cookies := response.Result().Cookies()
+	if len(cookies) != 1 || cookies[0].MaxAge >= 0 {
+		t.Fatalf("logout cookie must expire immediately: %#v", cookies)
+	}
+}
