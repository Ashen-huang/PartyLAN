diff --git a/turn/udp_only_test.go b/turn/udp_only_test.go
new file mode 100644
index 0000000..8bb03b8
--- /dev/null
+++ b/turn/udp_only_test.go
@@ -0,0 +1,43 @@
+package turn
+
+import (
+	"net"
+	"testing"
+
+	"github.com/rs/zerolog"
+	"github.com/screego/server/config"
+)
+
+func TestInternalServerDoesNotListenOnTCPWhenDisabled(t *testing.T) {
+	probe, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("reserve TURN port: %v", err)
+	}
+	turnAddress := probe.LocalAddr().String()
+	if err := probe.Close(); err != nil {
+		t.Fatalf("release TURN probe port: %v", err)
+	}
+
+	t.Setenv("SCREEGO_EXTERNAL_IP", "127.0.0.1")
+	t.Setenv("SCREEGO_SECRET", "partylan-test-secret")
+	t.Setenv("SCREEGO_TURN_ADDRESS", turnAddress)
+	t.Setenv("SCREEGO_TURN_ENABLE_TCP", "false")
+
+	conf, logs := config.Get()
+	for _, entry := range logs {
+		if entry.Level == zerolog.FatalLevel {
+			t.Fatalf("load config: %s", entry.Msg)
+		}
+	}
+	if _, err := newInternalServer(conf); err != nil {
+		t.Fatalf("start UDP-only TURN server: %v", err)
+	}
+
+	tcpListener, err := net.Listen("tcp", turnAddress)
+	if err != nil {
+		t.Fatalf("TCP address %s should remain unused: %v", turnAddress, err)
+	}
+	if err := tcpListener.Close(); err != nil {
+		t.Fatalf("close TCP probe: %v", err)
+	}
+}
