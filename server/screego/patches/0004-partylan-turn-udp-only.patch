diff --git a/ws/turn_transport_test.go b/ws/turn_transport_test.go
new file mode 100644
index 0000000..50bf9b6
--- /dev/null
+++ b/ws/turn_transport_test.go
@@ -0,0 +1,30 @@
+package ws
+
+import (
+	"net"
+	"reflect"
+	"testing"
+
+	"github.com/rs/zerolog"
+	"github.com/screego/server/config"
+)
+
+func TestTurnAddressesOmitTCPWhenDisabled(t *testing.T) {
+	t.Setenv("SCREEGO_EXTERNAL_IP", "127.0.0.1")
+	t.Setenv("SCREEGO_SECRET", "partylan-test-secret")
+	t.Setenv("SCREEGO_TURN_ENABLE_TCP", "false")
+
+	conf, logs := config.Get()
+	for _, entry := range logs {
+		if entry.Level == zerolog.FatalLevel {
+			t.Fatalf("load config: %s", entry.Msg)
+		}
+	}
+
+	rooms := &Rooms{config: conf}
+	got := rooms.addresses("turn", net.ParseIP("203.0.113.10"), nil, true)
+	want := []string{"turn:203.0.113.10:3478"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("TURN URLs = %v, want UDP-only %v", got, want)
+	}
+}
