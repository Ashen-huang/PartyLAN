new file mode 100644
index 0000000..1506ab1
--- /dev/null
+++ b/config/turn_transport_test.go
@@ -0,0 +1,39 @@
+package config
+
+import (
+	"os"
+	"testing"
+
+	"github.com/rs/zerolog"
+)
+
+func TestTurnEnableTCPDefaultsToTrue(t *testing.T) {
+	for _, name := range []string{
+		"SCREEGO_TURN_ENABLE_TCP",
+		"SCREEGO_EXTERNAL_IP",
+		"SCREEGO_TURN_EXTERNAL_IP",
+		"SCREEGO_SECRET",
+	} {
+		value, present := os.LookupEnv(name)
+		_ = os.Unsetenv(name)
+		t.Cleanup(func() {
+			if present {
+				_ = os.Setenv(name, value)
+			} else {
+				_ = os.Unsetenv(name)
+			}
+		})
+	}
+	_ = os.Setenv("SCREEGO_EXTERNAL_IP", "127.0.0.1")
+	_ = os.Setenv("SCREEGO_SECRET", "partylan-test-secret")
+
+	conf, logs := Get()
+	for _, entry := range logs {
+		if entry.Level == zerolog.FatalLevel {
+			t.Fatalf("load config: %s", entry.Msg)
+		}
+	}
+	if !conf.TurnEnableTCP {
+		t.Fatal("TURN TCP should remain enabled by default")
+	}
+}
