@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import test from 'node:test';
+
+const roomSource = await readFile(new URL('./Room.tsx', import.meta.url), 'utf8');
+const useRoomSource = await readFile(new URL('./useRoom.ts', import.meta.url), 'utf8');
+
+test('Room renders the native PartyLAN side rail and stable action hooks', () => {
+    assert.match(roomSource, /data-partylan-native-tools/);
+    assert.match(roomSource, /data-partylan-native-share="true"/);
+    assert.match(roomSource, /id="partylan-presence-roster"/);
+    assert.match(roomSource, /data-partylan-side="left"/);
+    assert.match(roomSource, /data-partylan-side="right"/);
+    assert.match(roomSource, /className=\{classes\.fullscreenControl\}/);
+    assert.match(roomSource, /aria-label="退出房间"/);
+    assert.match(roomSource, /aria-label="设置"/);
+    assert.match(roomSource, /<Typography variant="h6">共享<\/Typography>/);
+    assert.match(roomSource, /准备共享屏幕/);
+    assert.match(roomSource, /正在共享屏幕/);
+    assert.match(roomSource, /分辨率/);
+    assert.match(roomSource, /帧率/);
+    assert.match(roomSource, /窗口\/标签页音频/);
+    assert.match(roomSource, /系统音频/);
+    assert.match(roomSource, /无音频/);
+    assert.match(roomSource, /开始共享/);
+    assert.match(roomSource, /停止共享/);
+    assert.match(roomSource, /暂无共享画面/);
+    assert.match(roomSource, /result\.push\('你'\)/);
+    assert.match(roomSource, /result\.push\('房主'\)/);
+    assert.match(roomSource, /result\.push\('共享中'\)/);
+});
+
+test('Room no longer renders the legacy bottom control toolbar', () => {
+    assert.doesNotMatch(roomSource, /className=\{classes\.control\}/);
+    assert.doesNotMatch(roomSource, /classes\.sideRailBar/);
+    assert.match(roomSource, /data-partylan-side-content="left"/);
+    assert.match(roomSource, /data-partylan-side-content="right"/);
+    assert.match(roomSource, /@media \(max-width: 700px\), \(hover: none\), \(pointer: coarse\)/);
+});
+
+test('native share keeps the PartyLAN media control hook and room leave hook', () => {
+    assert.match(useRoomSource, /__PARTYLAN_NATIVE_UI_SHARE__/);
+    assert.match(useRoomSource, /const leave = \(\): void/);
+    assert.match(useRoomSource, /return \{state, room, share, stopShare, setName, leave\}/);
+});
